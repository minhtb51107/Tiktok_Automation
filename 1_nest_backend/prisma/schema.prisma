generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] 
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] 
}

// 1. THÊM ENUM TRẠNG THÁI TIẾN TRÌNH CHO WORKFLOW MỚI
enum VideoStatus {
  PENDING         // Mới khởi tạo bằng URL thô
  SCRIPT_READY    // AI đã viết xong kịch bản, chờ bạn kiểm tra/sửa text
  AUDIO_READY     // Đã tạo xong Audio TTS, Sub Whisper, Gifs, chờ bấm Render
  RENDERED        // Đã render thành công ra file MP4
  FAILED          // Bị lỗi ở một bước nào đó
}

model ThreadPost {
  id              String   @id @default(uuid())
  threadId        String   @unique 
  author          String
  avatarUrl       String?
  content         String
  attachedImg     String?
  url             String

  // ================= PHÂN LOẠI NỘI DUNG =================
  category        String   @default("DRAMA")        // 🔥 [MỚI]: Phân biệt "DRAMA" và "SERIOUS"

  // ================= QUẢN LÝ TIẾN TRÌNH 3 BƯỚC (BỔ SUNG MỚI) =================
  status          VideoStatus @default(PENDING)
  aiScriptDraft   Json?       
  finalScriptData Json?       

  // ================= AI SCORING & ĐẠO DIỄN =================
  aiScore         Int      @default(0)     
  vibe            String?
  sfx             String?
  memeMp4         String?
  
  // ================= QUẢN LÝ TRẠNG THÁI & UPLOAD =================
  caption         String?                           // Lưu Tiêu đề + Hashtag Tiktok
  isApproved      Boolean  @default(false) 
  isRendered      Boolean  @default(false) 
  isPublished     Boolean  @default(false) 

  // ================= BỘ NÃO VECTOR (ĐÃ GIỮ LẠI AN TOÀN) =================
  embedding       Unsupported("vector(768)")?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// GIỮ NGUYÊN MODEL LOG CỦA SẾP
model AiAuditLog {
  id           String   @id @default(uuid())
  provider     String   // Lưu tên Service (VD: GeminiService, OpenaiService)
  taskType     String?  // logic, data...
  prompt       String   @db.Text
  response     String?  @db.Text
  durationMs   Int      // Thời gian chờ API (để theo dõi độ trễ)
  isSuccess    Boolean  @default(true)
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
}