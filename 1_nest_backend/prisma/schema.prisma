generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] 
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] 
}

model ThreadPost {
  id              String   @id @default(uuid())
  threadId        String   @unique 
  author          String
  avatarUrl       String?
  content         String
  attachedImg     String?
  url             String

  // ================= AI SCORING & ĐẠO DIỄN =================
  aiScore         Int      @default(0)     
  vibe            String?                  
  sfx             String?                  
  memeMp4         String?                  
  
  // ================= QUẢN LÝ TRẠNG THÁI & UPLOAD =================
  caption         String?                  // 🔥 [MỚI THÊM VÀO]: Lưu Tiêu đề + Hashtag Tiktok
  isApproved      Boolean  @default(false) 
  isRendered      Boolean  @default(false) 
  isPublished     Boolean  @default(false) 

  // ================= BỘ NÃO VECTOR =================
  embedding       Unsupported("vector(768)")?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}