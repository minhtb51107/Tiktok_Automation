# Append these settings to your existing backend .env. Do not replace HF settings.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
# Proposed local HTTPS callback; requires hosts mapping + trusted local TLS first.
THREADS_REDIRECT_URI=https://threads-studio.test:3443/api/studio/threads/oauth/callback
# Optional, only for the explicitly started local OAuth HTTPS proxy.
THREADS_TLS_CERT=.studio-data/threads-api/tls/cert.pem
THREADS_TLS_KEY=.studio-data/threads-api/tls/key.pem

# Hugging Face Content Intelligence. Keep the real token only in .env.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=openai/gpt-oss-20b
HUGGINGFACE_PROVIDER=auto
HUGGINGFACE_REASONING_MODE=DISABLED
HUGGINGFACE_TIMEOUT_MS=60000
HUGGINGFACE_MAX_TOKENS=1800
HUGGINGFACE_REQUEST_BUDGET=4
HUGGINGFACE_TOKEN_BUDGET=12000
# Optional only when verified provider pricing is known for the selected route.
HUGGINGFACE_INPUT_USD_PER_MILLION=
HUGGINGFACE_OUTPUT_USD_PER_MILLION=
